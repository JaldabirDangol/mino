{
  "name": "mino-admin-assets",
  "private": true,
  "description": "Builds the admin panel's CSS and JS into internal/admin/static. Only needed when changing assets.",
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run copy",
    "build:css": "tailwindcss -i src/app.css -o ../internal/admin/static/app.css --minify",
    "build:js": "esbuild src/editor.js --bundle --minify --format=iife --target=es2020 --outfile=../internal/admin/static/editor.js",
    "copy": "node copy-vendor.mjs",
    "watch:css": "tailwindcss -i src/app.css -o ../internal/admin/static/app.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/cli": "4.3.5",
    "@tiptap/core": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "alpinejs": "3.17.5",
    "daisyui": "5.8.1",
    "esbuild": "0.28.2",
    "htmx.org": "2.0.11",
    "tailwindcss": "4.3.5"
  }
}
