# Copy to .env and adjust. docker compose reads this file automatically.

# Database password used by both containers.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Public address of the CMS. https:// enables secure cookies.
MINO_PUBLIC_URL=http://localhost:1337
MINO_PORT=1337

# Set to true when running behind a reverse proxy (Traefik, Caddy, nginx).
MINO_TRUST_PROXY=false

# Browser origins allowed to call the API; "*" allows any.
MINO_CORS_ORIGINS=*

# Media storage: leave MINO_S3_BUCKET empty to store files on the uploads volume.
MINO_S3_BUCKET=
MINO_S3_ENDPOINT=
MINO_S3_REGION=us-east-1
MINO_S3_ACCESS_KEY=
MINO_S3_SECRET_KEY=
MINO_S3_PUBLIC_URL=
